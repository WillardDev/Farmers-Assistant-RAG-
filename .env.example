# Copy this file to .env and fill in your MySQL details.
# .env is git-ignored - never commit real credentials.
#
# On Streamlit Community Cloud there is no .env: enter the same keys in
# App settings -> Secrets, as TOML (MYSQL_HOST = "..."). db.py copies them
# into the environment at startup. A local MySQL (localhost) is not reachable
# from Cloud, so use the host of a managed database there.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=maize_advisory
MYSQL_USER=root
MYSQL_PASSWORD=

# Managed providers (Aiven, TiDB Cloud, ...) require TLS. Paste the provider's
# CA certificate here, or set it to a path. Leave empty for a local server.
MYSQL_SSL_CA=
# Set to 1 only for a server that does not offer TLS at all.
MYSQL_SSL_DISABLED=

# Hugging Face access token (hf_...) for gated/private models. Public models
# need no token. Get one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Advisory answers are written by a hosted model, because a local generator
# does not fit Streamlit Community Cloud's ~2.7 GB of RAM. `auto` prefers Groq,
# then Gemini. Groq's free tier is the recommended default:
# https://console.groq.com/keys
ADVISORY_LLM_PROVIDER=auto
GROQ_API_KEY=
#GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
#GEMINI_MODEL=gemini-2.5-flash
# Hugging Face Inference Providers need pre-paid credits even on free accounts,
# and a plain HF_TOKEN is not enough: opt in explicitly.
#ADVISORY_LLM_PROVIDER=hf
#ADVISORY_HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Translation for Swahili and Dholuo (rag_pipeline.py).
# auto: Google if GOOGLE_TRANSLATE_API_KEY is set, otherwise the local int8
# NLLB model (~0.6 GB, downloaded on the first non-English question).
# google / llm: fully hosted;  local: force NLLB;  transformers: full NLLB.
ADVISORY_TRANSLATION_BACKEND=auto
GOOGLE_TRANSLATE_API_KEY=
# NLLB int8 conversion used by the `local` backend.
#ADVISORY_CT2_TRANSLATION_MODEL=JustFrederik/nllb-200-distilled-600M-ct2-int8
# Beam size for NLLB. 4 gives the most reliable Dholuo and keeps units such as
# "acre"; lower it to 1 for the fastest (but rougher) translation.
#ADVISORY_TRANSLATION_BEAM=4
#ADVISORY_LLM_TIMEOUT=120

# Optional voice settings (voice.py). The defaults are what the app ships with;
# uncomment only to change them.
# Whisper checkpoint: tiny, base, small, medium. `small` is the smallest that
# handles Kiswahili well; `base`/`tiny` save memory and lose domain words.
# Whisper has no Dholuo language token, so microphone input supports English and
# Kiswahili only. Dholuo questions can still be typed.
#VOICE_ASR_MODEL=small
# Comma-free domain vocabulary passed to Whisper as an initial prompt.
#VOICE_ASR_PROMPT=Kenyan maize farming. Kilimo cha mahindi Kenya: mbolea, DAP, CAN, ekari. Temo oduma: lowo, puodho.
# MMS text-to-speech voices, one per language. English and Kiswahili use Meta
# checkpoints. Meta did not release an official Dholuo MMS voice, so the default
# is a community MMS checkpoint trained on the same VITS architecture.
#VOICE_TTS_EN=facebook/mms-tts-eng
#VOICE_TTS_SW=facebook/mms-tts-swh
#VOICE_TTS_LUO=rnjema-unima/mms-tts-luo-baseline
