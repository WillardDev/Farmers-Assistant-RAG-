# Copy this file to .env and fill in your MySQL details.
# .env is git-ignored - never commit real credentials.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=maize_advisory
MYSQL_USER=root
MYSQL_PASSWORD=

# Hugging Face access token (hf_...) for gated/private models. Public models
# need no token. Get one at https://huggingface.co/settings/tokens
HF_TOKEN=
