# Generated by the notebook - safe to delete, re-created on every run
data_cls/
data_balanced/
runs/

# Model weights are large binaries - keep the folder, not the files.
# The fine-tuned checkpoint MUST be tracked: the Streamlit app cannot classify
# anything without it, and a deploy from git will not have it otherwise.
*.pt
*.keras
!models/maize_disease_yolo26s.pt
!models/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/

# Secrets - database credentials must never be committed.
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Uploaded farmer profile pictures (kept out of git)
profile_images/
